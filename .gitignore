venv/
__pycache__/
*.pyc

# generated graphs and CSVs
results/
# and any archive of them: a tarball of results/ is the obvious backup, and a
# `git add -A` would then stage binary that a later `git rm` cannot shrink out
# of the pack.
results*.tgz
results*.tar.gz
results*.tar.zst

# MRT files downloaded by new_vm.sh, and out-of-band NOS images/licenses
mrt/
nos/

# personal benchmark configs
benchmarks/local/
.pytest_cache/

# Retired Beads state is private recovery material, never source or evidence output.
/.beads/
/.retired-beads/
.dolt/
*.db
.beads-credential-key
