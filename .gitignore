venv/
__pycache__/
*.pyc

# generated graphs and CSVs
results/
# and any archive of them. `results/` is gitignored, so a tarball of it is the
# obvious way to back it up -- and a `git add -A` then stages 26 MB of binary
# that a later `git rm` cannot shrink out of the pack. Caught by review once.
results*.tgz
results*.tar.gz
results*.tar.zst

# MRT files downloaded by new_vm.sh, and out-of-band NOS images/licenses
mrt/
nos/

# personal benchmark configs
benchmarks/local/
.pytest_cache/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
# bd's issue database, its backups and its runtime append log. Kept here rather than in
# .beads/.gitignore, which bd rewrites on drift -- an ignore rule inside a tool-managed file
# is one the tool can take away, and what it would expose is the whole issue store.
/.beads/embeddeddolt/
/.beads/dolt/
/.beads/proxieddb/
/.beads/backup/
/.beads/interactions.jsonl
/.beads/*.db
/.beads/.env
/.beads/ephemeral.sqlite3*
